<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HENTAI Studio</AssemblyName>
    <RootNamespace>HENTAIStudio</RootNamespace>
    <ApplicationIcon>HENTAIStudio.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Authors>Lithium357</Authors>
    <Product>HENTAI Studio</Product>
    <Description>Native Windows control surface for Hierarchal Explicit Neural Text-to-Art Intelligence</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>
</Project>
