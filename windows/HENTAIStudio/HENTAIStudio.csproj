<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HENTAI Studio</AssemblyName>
    <RootNamespace>HENTAIStudio</RootNamespace>
    <ApplicationIcon>HENTAIStudio.ico</ApplicationIcon>
    <Version>0.8.0</Version>
    <Authors>Lithium357</Authors>
    <Product>HENTAI Studio</Product>
    <Description>Standalone local training project manager</Description>
  </PropertyGroup>

</Project>
